{
  "segments": [
    {
      "start": 0.0,
      "end": 3.72,
      "text": " أقوى خمس أدوات حتى تفتحلك لما تشترك في كامفة برو"
    },
    {
      "start": 3.72,
      "end": 7.96,
      "text": " وخمس أداء حرفياً كنز ومشكل الناس تعرف"
    },
    {
      "start": 7.96,
      "end": 10.72,
      "text": " الأداء الأولى مزيل الخلفية"
    },
    {
      "start": 10.72,
      "end": 15.08,
      "text": " لو عاوس تازل أي منتج أو شخص حتى لو تفصيلوا معقدة"
    },
    {
      "start": 15.08,
      "end": 16.96,
      "text": " كل العليك تضغط على الصورة"
    },
    {
      "start": 16.96,
      "end": 20.56,
      "text": " ومن الشريط العلوي تضغط على زر تعديل الصورة"
    },
    {
      "start": 20.56,
      "end": 23.56,
      "text": " حتى لي أول أداء هي مزيل الخلفية"
    },
    {
      "start": 23.56,
      "end": 27.92,
      "text": " بداخت واحدة الخلفية حتى تشلف سنية وبأعلى ضق"
    },
    {
      "start": 27.92,
      "end": 30.6,
      "text": " الأداء التانية الأمساك السحرية"
    },
    {
      "start": 30.6,
      "end": 32.96,
      "text": " وديائة ليها برضو لما تضغط على الصورة"
    },
    {
      "start": 32.96,
      "end": 35.8,
      "text": " وتفتح قائم التعديل الصورة من الشريط اللفو"
    },
    {
      "start": 35.8,
      "end": 38.08,
      "text": " وتختار الأمساك السحرية"
    },
    {
      "start": 38.08,
      "end": 42.28,
      "text": " الأداء تفصل أي عنصر جوة الصورة كأنه طبعا ممفاصلة"
    },
    {
      "start": 42.28,
      "end": 45.88,
      "text": " عشان تحركوا بالماوس تكبروا أو تكتب كلم وراء"
    },
    {
      "start": 45.88,
      "end": 48.56,
      "text": " كأنك شغل على فوتشوب الزبط"
    },
    {
      "start": 48.56,
      "end": 51.36,
      "text": " الأداء التلتة التوسية السحرية"
    },
    {
      "start": 51.36,
      "end": 52.76,
      "text": " لو عندك صورة بالعرض"
    },
    {
      "start": 52.76,
      "end": 56.32,
      "text": " وعوست خليها بالطول للريلز من غير مطأس منها حاجة"
    },
    {
      "start": 56.36,
      "end": 58.32,
      "text": " أضغط على تعديل الصورة من فوق"
    },
    {
      "start": 58.32,
      "end": 60.76,
      "text": " وختار أدات التوسية السحرية"
    },
    {
      "start": 60.76,
      "end": 62.36,
      "text": " وحدد المئسة العوزو"
    },
    {
      "start": 62.36,
      "end": 64.72,
      "text": " وذكاء الاستنوعي هي كم البائر خلفية"
    },
    {
      "start": 64.72,
      "end": 68.04,
      "text": " مقصة من عنده بشكل طبيعي ومبهر"
    },
    {
      "start": 68.04,
      "end": 71.04,
      "text": " الأداء الرابعة تغير الحجم السحرية"
    },
    {
      "start": 71.04,
      "end": 73.52,
      "text": " لو خلصت تصميم Post Instagram وربع"
    },
    {
      "start": 73.52,
      "end": 76.12,
      "text": " وعوست حولوا لستوري أو غلف Facebook"
    },
    {
      "start": 76.12,
      "end": 79.4,
      "text": " أضغط على زر تغير الحجم الموجود في أعلى الشاشة"
    },
    {
      "start": 79.4,
      "end": 82.2,
      "text": " على ليمين أو الشمال حسب لغت حسابك"
    },
    {
      "start": 82.2,
      "end": 83.92,
      "text": " وختار المئسات العوزة"
    },
    {
      "start": 83.92,
      "end": 87.16,
      "text": " وفي سنية هي عدل التصميم كله المئسة جديد"
    },
    {
      "start": 87.16,
      "end": 89.12,
      "text": " من غير متعيد مصفر"
    },
    {
      "start": 89.12,
      "end": 90.4,
      "text": " أما الأداء الخمسة"
    },
    {
      "start": 90.4,
      "end": 92.56,
      "text": " واللتعتبر السرر مخفي في كانوا"
    },
    {
      "start": 92.56,
      "end": 95.16,
      "text": " هي ابتكار تصميماد بالجملة"
    },
    {
      "start": 95.16,
      "end": 97.28,
      "text": " وديعش انت وصلهم للكمبيوتر"
    },
    {
      "start": 97.28,
      "end": 98.68,
      "text": " روح على الشبيت الجانبي"
    },
    {
      "start": 98.68,
      "end": 101.64,
      "text": " ونزل تحت خاضص عن ضقائمة التطبيعات"
    },
    {
      "start": 101.64,
      "end": 102.84,
      "text": " وكتب في البحس"
    },
    {
      "start": 102.84,
      "end": 104.96,
      "text": " ابتكار تصميماد بالجملة"
    },
    {
      "start": 104.96,
      "end": 109.2,
      "text": " الأدادي بتخليك تدخل جد والفي 30 جملة أو 30 منتج"
    },
    {
      "start": 109.2,
      "end": 111.2,
      "text": " وتربطهم بتصميم واحد"
    },
    {
      "start": 111.28,
      "end": 112.28,
      "text": " وبضغتت زر"
    },
    {
      "start": 112.28,
      "end": 115.12,
      "text": " كانوا هي عملك 30 تصميم مختلفين"
    },
    {
      "start": 115.12,
      "end": 117.68,
      "text": " وجهزين للنشر في أقل مندييا"
    },
    {
      "start": 117.68,
      "end": 120.44,
      "text": " تضر تفتح كل الأدواتك جبارادي"
    },
    {
      "start": 120.44,
      "end": 122.12,
      "text": " وتوفر ساعات من وقتك"
    },
    {
      "start": 122.12,
      "end": 126.12,
      "text": " لما تشترك في كامفة Pro مدى الحياة من خلالنا فلورن EG"
    },
    {
      "start": 126.12,
      "end": 129.6,
      "text": " بسر يبدأ من 100% 40 جني بس"
    },
    {
      "start": 129.6,
      "end": 132.6,
      "text": " مع ضمان كامل لمدة سنة على إميلك الشخصي"
    },
    {
      "start": 132.6,
      "end": 134.28,
      "text": " ودعم فاني مستمر"
    },
    {
      "start": 134.28,
      "end": 137.16,
      "text": " ابعتلنا دلوقتي كلمة كامفة فرسيل الصفحة"
    },
    {
      "start": 137.16,
      "end": 139.32,
      "text": " وحن بعاتلك كل التفاصيل فورن"
    },
    {
      "start": 139.6,
      "end": 141.72,
      "text": " ودلوقتي والنفى الكومنتات"
    },
    {
      "start": 141.72,
      "end": 143.32,
      "text": " كما أدامنا الخمس دول"
    },
    {
      "start": 143.32,
      "end": 145.32,
      "text": " كنت تعرفهم وبتستخدمهم"
    }
  ],
